# Copy to .env and fill in real values. Never commit .env.
# All values below are placeholders. Chat and embedding are configured separately:
# do not assume your chat provider also serves embeddings.

# --- Chat model (OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=your-chat-model-name
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Embedding model (independent provider/endpoint) ---
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://your-embedding-provider.example.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=your-embedding-model-name
EMBEDDING_DIMENSIONS=0

# --- Retrieval / context limits ---
REPOASK_TOP_K=6
REPOASK_CONTEXT_CHAR_BUDGET=8000
